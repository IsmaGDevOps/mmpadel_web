<?xml version="1.0"?>
<ruleset name="MMPadel">
	<description>Estándares de WordPress para el tema mmpadel y el plugin mmpadel-core.</description>

	<file>./themes/mmpadel</file>
	<file>./plugins/mmpadel-core</file>
	<file>./dev</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Prefijos obligatorios para todo lo global. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mmpadel"/>
			</property>
		</properties>
	</rule>

	<!-- Las plantillas del plugin se cargan con load_template() dentro de una
	     función: sus variables son locales, no globales. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/plugins/mmpadel-core/templates/*</exclude-pattern>
	</rule>

	<!-- Permisos propios de las solicitudes (MMPadel_Post_Types::add_caps()). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_mmpadel_solicitudes"/>
				<element value="read_private_mmpadel_solicitudes"/>
			</property>
		</properties>
	</rule>

	<!-- Dominios de traducción válidos. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mmpadel"/>
				<element value="mmpadel-core"/>
			</property>
		</properties>
	</rule>
</ruleset>
