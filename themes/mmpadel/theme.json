{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "primario", "color": "#0E5C4A", "name": "Primario" },
        { "slug": "primario-oscuro", "color": "#08392E", "name": "Primario oscuro" },
        { "slug": "acento", "color": "#D7F25C", "name": "Acento" },
        { "slug": "texto", "color": "#1B1F1D", "name": "Texto" },
        { "slug": "texto-suave", "color": "#55605B", "name": "Texto suave" },
        { "slug": "fondo", "color": "#FFFFFF", "name": "Fondo" },
        { "slug": "fondo-suave", "color": "#F3F6F4", "name": "Fondo suave" },
        { "slug": "borde", "color": "#DCE3DF", "name": "Borde" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "base",
          "name": "Sistema",
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "titulos",
          "name": "Títulos",
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Pequeño", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Normal", "size": "1.0625rem", "fluid": false },
        { "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Muy grande", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
        { "slug": "xx-large", "name": "Enorme", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3.25rem" } }
      ]
    },
    "spacing": {
      "units": [ "px", "rem", "%", "vw" ],
      "defaultSpacingSizes": false,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "1.5rem" },
        { "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 3rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 5rem)" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--fondo)",
      "text": "var(--wp--preset--color--texto)"
    },
    "spacing": {
      "padding": {
        "left": "1rem",
        "right": "1rem"
      },
      "blockGap": "1.25rem"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--base)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primario)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primario-oscuro)" } }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--titulos)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primario)",
          "text": "var(--wp--preset--color--fondo)"
        },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "600" },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--primario-oscuro)" }
        }
      }
    }
  }
}
